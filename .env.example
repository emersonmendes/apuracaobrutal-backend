# Copie para `.env` no desenvolvimento local. Só este template é versionado.

# Ambiente de execução. Qualquer valor diferente de `production` monta o Swagger em /docs
# (spec: backend-bootstrap R-5).
NODE_ENV=development

# Porta HTTP do servidor (spec: dev-environment R-2 → backend = 3433).
PORT=3433

# String de conexão do PostgreSQL, usada pela aplicação e pelo Prisma Migrate.
# Host (execução nativa): localhost:5433 — rede Docker: postgres:5432
DATABASE_URL=postgresql://apuracaobrutal:apuracaobrutal@localhost:5433/apuracaobrutal

# Origens do navegador aceitas pelo CORS, separadas por vírgula (spec: backend-bootstrap FR-05, R-6).
# `*` é sempre ignorado. Padrão: http://localhost:3100 (web local).
CORS_ORIGINS=http://localhost:3100

# Número exato de proxies reversos entre o cliente e o backend (spec: backend-bootstrap FR-03, R-9).
# 0 = sem proxy (padrão, local). Produção atrás de um ALB: 1. Inteiro de 0 a 10; nunca `true`/`*`.
TRUST_PROXY=0

# --- Feed da apuração / worker (spec: election-results-feed FR-01) ---------------------------

# Prefixo <host>/<ambiente> dos arquivos do TSE (https, sem barra final).
# Simulado do TSE: https://resultados-sim.tse.jus.br/simulado/simulado2026
TSE_RESULTS_URL=https://resultados.tse.jus.br/oficial
# Pasta do ciclo eleitoral; o ano exibido são os 4 dígitos finais.
TSE_CYCLE=ele2026
# Código da eleição: 6258 = 2º turno federal 2026 (simulado: 21270 = 1º turno federal).
TSE_ELECTION_CODE=6258
# Chave pública JWK (Ed25519) para verificar a assinatura dos arquivos .jws, em uma linha.
# Padrão (vazio): chave OFICIAL do manual de verificação JWS do TSE (Apêndice B).
# Simulado do TSE usa a chave de DESENVOLVIMENTO (Apêndice A):
# TSE_JWS_PUBLIC_JWK={"kty":"OKP","crv":"Ed25519","kid":"pEGrlis0i8vO2Bz7Ergwr0MnKfg","x":"81fm_gXW6Q5gBWrGJkE7j5MOS5vmTnRqqFHfdMeRbsw"}
TSE_JWS_PUBLIC_JWK=
# Número na urna do candidato vermelho (esquerda) e do azul (direita). Simulado: 57 e 89.
ELECTION_RED_CANDIDATE_NUMBER=13
ELECTION_BLUE_CANDIDATE_NUMBER=22
# Intervalo entre ciclos do worker, em segundos (mín. 5).
TSE_POLL_INTERVAL_SECONDS=15
# Sem sucesso no arquivo Brasil por mais que isso → fonte "failed" (mín. 2 × intervalo).
SOURCE_STALE_AFTER_SECONDS=90
# Intervalo (ms) em que o backend checa mudanças no banco para o SSE (mín. 500).
FEED_REFRESH_MS=2000
# Limite de conexões SSE simultâneas por instância.
SSE_MAX_CLIENTS=5000

# --- Patrocínios na arena (spec: sponsorships FR-01) -------------------------------------------

# Gateway de pagamento: `simulated` (nenhuma cobrança real; indisponível com NODE_ENV=production,
# R-9) ou `asaas` (cobrança real — ver bloco Asaas abaixo; spec asaas-payment R-1).
PAYMENT_GATEWAY=simulated
# Preço por minuto de cada local NO DIA DA ELEIÇÃO, em centavos (R-1, R-3). As duas luvas e as
# duas laterais compartilham uma única chave (neutralidade, R-2).
SPONSORSHIP_PRICE_FLOOR_CENTS=500000
SPONSORSHIP_PRICE_CENTER_CENTS=300000
SPONSORSHIP_PRICE_GLOVE_CENTS=200000
SPONSORSHIP_PRICE_SIDE_CENTS=100000
# Dia da eleição (AAAA-MM-DD, fuso America/Sao_Paulo): o preço cheio acima só vale para pedidos
# cujo tempo no ar toca esse dia (spec sponsorship-election-pricing R-1, R-3).
SPONSORSHIP_ELECTION_DATE=2026-10-25
# Preço reduzido por minuto das laterais fora do dia da eleição, em centavos; os outros locais
# seguem a mesma proporção da tabela cheia (R-2). 500 → laterais R$ 5, luvas R$ 10, centro R$ 15,
# chão R$ 25.
SPONSORSHIP_STANDARD_PRICE_SIDE_CENTS=500
# Máximo de minutos por pedido (inteiro ≥ 1).
SPONSORSHIP_MAX_MINUTES=60
# Validade de um pedido sem pagamento, em minutos (≥ 5).
SPONSORSHIP_PAYMENT_TTL_MINUTES=30
# Tamanho máximo do upload da imagem, em bytes (3 MB).
SPONSORSHIP_IMAGE_MAX_BYTES=3145728
# --- Armazenamento das imagens reprocessadas (spec: sponsorship-s3-storage FR-01) -------------
# `local` (pasta/volume compartilhado entre backend e worker; SÓ desenvolvimento — com
# NODE_ENV=production o processo não sobe) ou `s3` (bucket privado; backend grava/lê/apaga, worker
# lê/apaga). Backend e worker precisam do MESMO valor.
SPONSORSHIP_STORAGE=local
# Só com `local`: pasta das imagens (backend grava, worker limpa — mesmo volume nos dois).
SPONSORSHIP_STORAGE_DIR=./storage/sponsorships
# Só com `s3`: nome do bucket (em produção vem do Terraform: apuracaobrutal-prod-sponsorship-images).
# Região e credenciais: AWS_REGION / AWS_PROFILE do bloco de moderação abaixo (cadeia padrão do SDK;
# em produção, IAM role da task). Nenhuma URL do bucket é exposta: a imagem continua servida pelo
# backend em GET /sponsorships/:id/image.
# SPONSORSHIP_S3_BUCKET=
# Só desenvolvimento: S3 compatível (MinIO/LocalStack) com path-style; recusada em produção.
# SPONSORSHIP_S3_ENDPOINT=http://localhost:9000
# Timeout por tentativa de cada chamada ao S3, em ms (≥ 1000; até 3 tentativas).
SPONSORSHIP_S3_TIMEOUT_MS=10000
# Pedidos criados por IP por hora.
SPONSORSHIP_CREATE_LIMIT_PER_HOUR=10
# Só o worker (FR-05): `false` desliga limpeza, estorno e moderação dos patrocínios — a instância
# só acompanha a apuração. A fila de patrocínios é única: exatamente um worker deve ficar em `true`.
# SPONSORSHIP_WORKER_ENABLED=true

# --- Pagamento real via Asaas (spec: asaas-payment FR-01) ------------------------------------
# PAYMENT_GATEWAY=asaas liga o adapter real; as variáveis abaixo passam a ser obrigatórias.
# Com `simulated` elas são ignoradas. Chave e token ficam só neste `.env` (nunca versionar).
# Ambiente do Asaas: `sandbox` (https://api-sandbox.asaas.com/v3) ou `production`
# (https://api.asaas.com/v3). Sandbox nunca movimenta dinheiro e é identificado na UI.
ASAAS_ENVIRONMENT=sandbox
# Chave de API do ambiente escolhido (painel do Asaas > Integrações). Nunca logada. A chave começa
# com `$`: coloque o valor entre ASPAS SIMPLES (ex.: ASAAS_API_KEY='$aact_...'), senão o shell do
# `make backend`/`make worker` expande o `$` e a chave chega vazia.
ASAAS_API_KEY=''
# Token que o Asaas envia no header `asaas-access-token` do webhook (R-6): 32–255 caracteres,
# sem espaços, diferente da chave. Gere com `openssl rand -hex 32` e use o mesmo valor ao
# cadastrar o webhook (requests/asaas.http).
ASAAS_WEBHOOK_TOKEN=
# Timeout de cada chamada ao Asaas, em ms (≥ 1000).
ASAAS_TIMEOUT_MS=10000

# --- Moderação automática das imagens (spec: sponsorship-image-moderation FR-01) --------------
# Toda imagem é analisada pelo WORKER (Amazon Rekognition: rótulos de conteúdo impróprio, texto lido
# e pessoas públicas reconhecidas) antes de poder ser paga/publicada. O Rekognition é só do worker;
# o backend HTTP usa credenciais da AWS apenas com SPONSORSHIP_STORAGE=s3 (sponsorship-s3-storage).
# Analisador: `rekognition` (real) ou `simulated` (aprova tudo após 1 s; SÓ desenvolvimento — com
# NODE_ENV=production o worker não sobe).
SPONSORSHIP_MODERATION=rekognition
# Região do Rekognition e do bucket S3 (us-east-1 é a decisão do produto).
AWS_REGION=us-east-1
# Credenciais pela cadeia padrão do SDK. Em desenvolvimento, um profile do ~/.aws (ex.: puoro);
# em produção, IAM role da task (worker: rekognition:DetectModerationLabels, DetectText,
# RecognizeCelebrities + S3 get/delete/list; backend: S3 put/get/delete/list) — sem chave
# estática. Nunca logadas nem versionadas.
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Timeout de cada tentativa (as três chamadas juntas), em ms (≥ 2000).
REKOGNITION_TIMEOUT_MS=15000
# Confiança mínima (inteiro 50–100) de um rótulo do Rekognition para recusar a imagem (R-4 D-2/D-3).
SPONSORSHIP_MODERATION_LABEL_MIN_CONFIDENCE=60
# Confiança mínima (inteiro 50–100) de um rosto reconhecido como um dos candidatos (R-4 D-6).
SPONSORSHIP_MODERATION_CELEBRITY_MIN_CONFIDENCE=90
# Tentativas por pedido antes de `error` definitivo (1–5). Depois disso a pessoa envia outro pedido.
SPONSORSHIP_MODERATION_MAX_ATTEMPTS=3
# Teto global de tentativas por hora (cada uma = até 3 chamadas; limite de custo); além dele os
# pedidos esperam.
SPONSORSHIP_MODERATION_MAX_PER_HOUR=200
