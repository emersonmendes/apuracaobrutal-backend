// apuracaobrutal-backend — schema Prisma.
// Fonte da verdade da estrutura do banco. Toda mudança estrutural passa pelo Prisma Migrate
// (nunca SQL cru / `db push` em ambientes compartilhados).
//
// Este baseline NÃO declara modelos de propósito (spec: backend-bootstrap R-8): cada spec de
// feature adiciona seus modelos aqui e gera uma migration via `make migrate name=<mudança>`.
//
// Nomes físicos em snake_case, sem aspas: todo modelo com @@map, todo campo de várias palavras
// com @map, todo enum com @@map (ai/conventions.md#nomes-no-banco-de-dados).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------------------------
// election-results-feed (FR-05): histórico append-only dos arquivos EA20 aceitos do TSE, eventos
// de apuração e estado durável do worker.
// ---------------------------------------------------------------------------------------------

/// Resultado aceito de um escopo (br ou UF). Nunca apagado nem reescrito.
model ScopeResult {
  id                 Int               @id @default(autoincrement())
  electionCode       String            @map("election_code")
  scope              String
  round              Int
  phase              String
  generationId       String            @map("generation_id")
  generatedAt        DateTime          @map("generated_at") @db.Timestamptz(3)
  totalizedAt        DateTime?         @map("totalized_at") @db.Timestamptz(3)
  disclosable        Boolean
  progress           String
  final              Boolean
  noWinnerAssigned   Boolean           @map("no_winner_assigned")
  sectionsTotal      Int               @map("sections_total")
  sectionsCounted    Int               @map("sections_counted")
  countedSectionsPct Decimal           @map("counted_sections_pct") @db.Decimal(12, 9)
  electorate         Int
  validVotes         Int               @map("valid_votes")
  contentHash        String            @map("content_hash")
  etag               String?
  rawPayload         Json              @map("raw_payload")
  receivedAt         DateTime          @map("received_at") @db.Timestamptz(3)
  candidates         CandidateResult[]

  @@unique([electionCode, scope, generationId])
  @@index([electionCode, scope, id])
  @@map("scope_result")
}

/// Candidato de um ScopeResult.
model CandidateResult {
  id            Int         @id @default(autoincrement())
  scopeResultId Int         @map("scope_result_id")
  scopeResult   ScopeResult @relation(fields: [scopeResultId], references: [id], onDelete: Restrict)
  number        Int
  sqcand        String
  ballotName    String      @map("ballot_name")
  party         String
  votes         Int
  validVotesPct Decimal     @map("valid_votes_pct") @db.Decimal(12, 9)
  elected       Boolean
  situation     String?

  @@index([scopeResultId])
  @@map("candidate_result")
}

/// Estado do worker por escopo (R-3, R-7, R-11).
model ScopeSourceState {
  electionCode    String    @map("election_code")
  scope           String
  lastGeneratedAt DateTime? @map("last_generated_at") @db.Timestamptz(3)
  lastEtag        String?   @map("last_etag")
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(3)
  notFoundUntil   DateTime? @map("not_found_until") @db.Timestamptz(3)

  @@id([electionCode, scope])
  @@map("scope_source_state")
}

/// Evento de apuração (R-9), deduplicado por chave.
model ElectionEvent {
  id           String   @id @default(uuid()) @db.Uuid
  seq          Int      @default(autoincrement())
  electionCode String   @map("election_code")
  kind         String
  dedupeKey    String   @map("dedupe_key")
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  text         String
  side         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([electionCode, dedupeKey])
  @@index([electionCode, occurredAt(sort: Desc), seq(sort: Desc)])
  @@map("election_event")
}

/// Evento de combate (combat-events R-1…R-6): golpe já decidido, deduplicado pela chave do
/// evento de apuração de origem.
model CombatEvent {
  id           String   @id @default(uuid()) @db.Uuid
  seq          Int      @default(autoincrement())
  electionCode String   @map("election_code")
  cause        String
  dedupeKey    String   @map("dedupe_key")
  red          String
  blue         String
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([electionCode, dedupeKey])
  @@index([electionCode, seq(sort: Desc)])
  @@map("combat_event")
}

/// Saúde da fonte e versão do feed, uma linha por eleição (R-10, R-11).
model SourceStatus {
  electionCode  String    @id @map("election_code")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  blockedUntil  DateTime? @map("blocked_until") @db.Timestamptz(3)
  feedVersion   Int       @default(0) @map("feed_version")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("source_status")
}

// ---------------------------------------------------------------------------------------------
// sponsorships (FR-02): pedidos de patrocínio por minuto. Nunca apagados (auditoria); preço
// congelado no pedido (R-3).
// ---------------------------------------------------------------------------------------------

enum SponsorshipSlot {
  side_left
  side_right
  center
  floor
  glove_red
  glove_blue

  @@map("sponsorship_slot")
}

enum SponsorshipStatus {
  pending_payment
  scheduled
  expired

  @@map("sponsorship_status")
}

/// Faixa de preço do pedido (spec sponsorship-election-pricing R-2, R-3).
enum SponsorshipPriceTier {
  standard
  election_day

  @@map("sponsorship_price_tier")
}

/// Forma com que a cobrança foi paga (spec asaas-payment R-5).
enum SponsorshipPaymentMethod {
  pix
  credit_card
  other

  @@map("sponsorship_payment_method")
}

/// Estado do estorno de um pagamento recebido que não pôde ser agendado (asaas-payment R-7).
enum SponsorshipRefund {
  none
  requested
  done
  failed

  @@map("sponsorship_refund")
}

/// Motivo de um pedido ter expirado (asaas-payment R-5, R-8; sponsorship-image-moderation R-2, R-7).
enum SponsorshipExpiryReason {
  payment_timeout
  price_changed
  moderation_rejected
  moderation_error
  moderation_pending

  @@map("sponsorship_expiry_reason")
}

/// Estado da moderação automática da imagem (sponsorship-image-moderation R-2).
enum SponsorshipModeration {
  pending
  approved
  rejected
  error

  @@map("sponsorship_moderation")
}

/// Desfecho de uma tentativa de moderação (sponsorship-image-moderation R-9).
enum ModerationOutcome {
  approved
  rejected
  error

  @@map("moderation_outcome")
}

/// Desfecho gravado com cada evento de webhook recebido (asaas-payment FR-02, R-6).
enum PaymentWebhookOutcome {
  scheduled
  refund_requested
  refund_done
  ignored
  rejected

  @@map("payment_webhook_outcome")
}

/// Pedido de patrocínio (R-4). `startsAt`/`endsAt` só existem quando `scheduled` (R-5).
model Sponsorship {
  id                      String                    @id @db.Uuid
  slot                    SponsorshipSlot
  minutes                 Int
  /// Congelada na criação; revalidada na confirmação (sponsorship-election-pricing R-4, R-5).
  priceTier               SponsorshipPriceTier      @map("price_tier")
  unitPriceCents          Int                       @map("unit_price_cents")
  amountCents             Int                       @map("amount_cents")
  advertiserName          String                    @map("advertiser_name")
  email                   String
  /// CPF/CNPJ do pagador, só dígitos (asaas-payment R-2); nulo em pedidos anteriores.
  cpfCnpj                 String?                   @map("cpf_cnpj")
  /// Link opcional do anúncio, http(s) (sponsor-link R-1).
  linkUrl                 String?                   @map("link_url")
  /// `null` depois que a limpeza do worker apaga a imagem (FR-05).
  imageKey                String?                   @map("image_key")
  /// SHA-256 (hex) do WebP gravado (sponsorship-image-moderation R-6); nulo em linhas antigas.
  imageSha256             String?                   @map("image_sha256")
  status                  SponsorshipStatus
  /// Moderação automática (sponsorship-image-moderation R-2); independente de `status`.
  moderation              SponsorshipModeration     @default(pending)
  moderationAttempts      Int                       @default(0) @map("moderation_attempts")
  moderationNextAttemptAt DateTime?                 @map("moderation_next_attempt_at") @db.Timestamptz(3)
  moderationClaimedUntil  DateTime?                 @map("moderation_claimed_until") @db.Timestamptz(3)
  moderatedAt             DateTime?                 @map("moderated_at") @db.Timestamptz(3)
  /// Categorias da decisão final (vazio fora de `rejected`).
  moderationCategories    String[]                  @default([]) @map("moderation_categories")
  paymentGateway          String                    @map("payment_gateway")
  chargeId                String                    @map("charge_id")
  /// Cliente da cobrança no gateway e fatura hospedada (asaas-payment R-3).
  gatewayCustomerId       String?                   @map("gateway_customer_id")
  invoiceUrl              String?                   @map("invoice_url")
  paymentMethod           SponsorshipPaymentMethod? @map("payment_method")
  paidAt                  DateTime?                 @map("paid_at") @db.Timestamptz(3)
  refund                  SponsorshipRefund         @default(none)
  refundAttempts          Int                       @default(0) @map("refund_attempts")
  refundedAt              DateTime?                 @map("refunded_at") @db.Timestamptz(3)
  expiryReason            SponsorshipExpiryReason?  @map("expiry_reason")
  createdAt               DateTime                  @map("created_at") @db.Timestamptz(3)
  paymentExpiresAt        DateTime                  @map("payment_expires_at") @db.Timestamptz(3)
  confirmedAt             DateTime?                 @map("confirmed_at") @db.Timestamptz(3)
  startsAt                DateTime?                 @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime?                 @map("ends_at") @db.Timestamptz(3)

  @@unique([paymentGateway, chargeId])
  @@index([slot, status, endsAt])
  @@index([refund])
  @@index([moderation, moderationNextAttemptAt])
  @@map("sponsorship")
}

/// Registro de auditoria de uma tentativa de moderação (sponsorship-image-moderation FR-02, R-9).
/// Uma linha por tentativa; nunca apagada. Nunca contém credenciais nem dados do anunciante.
model SponsorshipModerationRecord {
  id             String            @id @default(uuid()) @db.Uuid
  sponsorshipId  String            @map("sponsorship_id") @db.Uuid
  attempt        Int
  provider       String
  model          String?
  policyVersion  String            @map("policy_version")
  outcome        ModerationOutcome
  /// Decisão bruta do modelo na v1 (Claude); sempre nula na v2 (Rekognition). Mantida pelo histórico.
  modelDecision  String?           @map("model_decision")
  categories     String[]          @default([])
  reasons        String[]          @default([])
  detectedText   String[]          @default([]) @map("detected_text")
  confidence     Decimal?          @db.Decimal(4, 3)
  /// Regras determinísticas acionadas (ex.: `D-3`).
  rejectionRules String[]          @default([]) @map("rejection_rules")
  errorCode      String?           @map("error_code")
  requestId      String?           @map("request_id")
  imageSha256    String?           @map("image_sha256")
  latencyMs      Int               @map("latency_ms")
  /// Tokens da v1 (Claude); sempre nulos na v2 (Rekognition). Mantidos pelo histórico.
  inputTokens    Int?              @map("input_tokens")
  outputTokens   Int?              @map("output_tokens")
  /// Sinais normalizados do provedor (R-3): rótulos, tipos de conteúdo, linhas de texto, contagem
  /// de palavras, saturação e pessoas reconhecidas. Base da calibração (AC-23).
  signals        Json?
  createdAt      DateTime          @map("created_at") @db.Timestamptz(3)

  @@unique([sponsorshipId, attempt])
  @@index([sponsorshipId])
  @@index([provider, createdAt])
  @@map("sponsorship_moderation_record")
}

/// Evento de webhook do gateway de pagamento (asaas-payment FR-02, R-6). O `id` é o do evento no
/// gateway: chave de idempotência. Guardado para auditoria; nunca apagado.
model PaymentWebhookEvent {
  id            String                @id
  gateway       String
  event         String
  chargeId      String?               @map("charge_id")
  sponsorshipId String?               @map("sponsorship_id") @db.Uuid
  receivedAt    DateTime              @map("received_at") @db.Timestamptz(3)
  outcome       PaymentWebhookOutcome
  payload       Json

  @@index([sponsorshipId])
  @@map("payment_webhook_event")
}
